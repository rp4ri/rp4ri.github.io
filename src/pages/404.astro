---
const target = "https://tajibo.lat/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rodrigo Pari</title>
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline>
      window.location.replace("https://tajibo.lat/");
    </script>
  </head>
  <body>
    <p>Moved to <a href={target}>tajibo.lat</a></p>
  </body>
</html>
